<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Welcome to Digital Healthcare</title>
</head>
<body style="margin: 0; padding: 0; background-color: #f4f7fb; font-family: 'Segoe UI', Arial, Helvetica, sans-serif; -webkit-font-smoothing: antialiased;">

    <!-- Wrapper Table for Email Client Compatibility -->
    <table width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color: #f4f7fb; padding: 40px 20px;">
        <tr>
            <td align="center">
                
                <!-- Main Container -->
                <table width="100%" cellpadding="0" cellspacing="0" border="0" style="max-width: 600px; background-color: #ffffff; border-radius: 12px; overflow: hidden; border: 1px solid #e5e7eb; box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);">
                    
                    <!-- Header -->
                    <tr>
                        <td style="background-color: #0d9488; padding: 32px 20px; text-align: center;">
                            <h1 style="margin: 0; color: #ffffff; font-size: 26px; font-weight: bold; letter-spacing: 0.5px;">
                                Digital Healthcare
                            </h1>
                            <p style="margin: 8px 0 0; color: #ccfbf1; font-size: 15px;">
                                Secure Healthcare Management
                            </p>
                        </td>
                    </tr>

                    <!-- Content -->
                    <tr>
                        <td style="padding: 40px 30px;">
                            
                            <!-- Greeting -->
                            <h2 style="margin: 0 0 4px; color: #111827; font-size: 22px;">
                                Welcome, <%= name %>!
                            </h2>
                            <p style="margin: 0 0 24px; color: #6b7280; font-size: 14px;">
                                Account Email: <%= email %>
                            </p>

                            <!-- Welcome Message -->
                            <p style="margin: 0 0 20px; color: #4b5563; font-size: 16px; line-height: 1.7;">
                                Thank you for joining the Digital Healthcare Platform. Your account has been successfully created and you are now automatically logged in.
                            </p>
                            
                            <p style="margin: 0 0 35px; color: #4b5563; font-size: 16px; line-height: 1.7;">
                                You can immediately start exploring the platform to book appointments with top doctors, manage your medical records, and access your digital prescriptions all in one secure place.
                            </p>

                            <!-- Security Notes -->
                            <p style="margin: 0 0 12px; color: #6b7280; font-size: 14px; line-height: 1.6; border-top: 1px solid #e5e7eb; padding-top: 20px;">
                                If you have any questions or need assistance, our support team is always here to help.
                            </p>
                            <p style="margin: 0; color: #6b7280; font-size: 14px; line-height: 1.6;">
                                If you did not create this account, please contact our support team immediately or ignore this email.
                            </p>

                        </td>
                    </tr>

                    <!-- Footer -->
                    <tr>
                        <td style="padding: 24px 30px; background-color: #f8fafc; border-top: 1px solid #e5e7eb; text-align: center;">
                            <p style="margin: 0 0 8px; color: #475569; font-size: 14px; font-weight: bold;">
                                Digital Healthcare Platform
                            </p>
                            <p style="margin: 0 0 16px; color: #94a3b8; font-size: 12px; line-height: 1.5;">
                                Backend API for a digital healthcare platform supporting doctor management, appointments, payments, consultations, authentication, and digital prescriptions.
                            </p>
                            <p style="margin: 0; color: #cbd5e1; font-size: 11px;">
                                This is an automated email. Please do not reply.
                            </p>
                        </td>
                    </tr>

                </table>
            </td>
        </tr>
    </table>

</body>
</html>